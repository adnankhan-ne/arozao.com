# ==============================================================================
# AROZAO STOREFRONT & MARKETPLACE — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# WARNING: Never commit real API keys or service secrets to version control.

# Local Development Server Port
PORT=3000

# Canonical Site URL (used for SEO canonical links, sitemap.xml, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://arozao.com

# Password Recovery Redirect URL (redirects users from recovery emails to the reset UI)
NEXT_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://arozao.com/login?mode=update-password

# ------------------------------------------------------------------------------
# 1. PHP / MYSQL BACKEND
# ------------------------------------------------------------------------------
# Server-side URL to the XAMPP PHP API.
PHP_API_URL=http://localhost/Arozao%20Website/api
PHP_INTERNAL_KEY=replace_with_the_same_random_secret_used_by_php
ADMIN_BOOTSTRAP_EMAIL=admin@example.com


# ------------------------------------------------------------------------------
# 2. BANGLADESH PAYMENT GATEWAY SECRETS (SERVER-SIDE ONLY — OPTIONAL UNTIL LIVE)
# ------------------------------------------------------------------------------
# Shared secret for verifying payment gateway webhooks at POST /api/payments/webhook
PAYMENT_WEBHOOK_SECRET=your-webhook-hmac-secret-here

# bKash Tokenized Checkout API (Server-side only)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Merchant PGW (Server-side only)
NAGAD_MERCHANT_ID=
NAGAD_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

# SSLCommerz Bangladesh Aggregator (Server-side only)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_LIVE=false

# ------------------------------------------------------------------------------
# 3. BANGLADESH COURIER & LOGISTICS APIs (SERVER-SIDE ONLY — OPTIONAL UNTIL LIVE)
# ------------------------------------------------------------------------------
PATHAO_COURIER_API_KEY=
PATHAO_COURIER_SECRET=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. AROZAO OFFICIAL EMAIL SYSTEM (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# WARNING: NEVER prefix SMTP credentials, Gmail App Passwords, OAuth secrets,
# or email API keys with NEXT_PUBLIC_. Keep all email secrets server-side only.
EMAIL_FROM=arozao.official@gmail.com
EMAIL_REPLY_TO=arozao.official@gmail.com
EMAIL_SENDER_NAME=AROZAO

# Gmail / SMTP Transport Configuration (Server-side only)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=arozao.official@gmail.com
EMAIL_SMTP_PASS=

# Optional HTTP Transactional Email Provider API Key (Server-side only)
RESEND_API_KEY=
